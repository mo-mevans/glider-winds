   "outputs": [],
   "source": [
    "# De-duplicate rows so re-running downstream cells does not grow df_main with repeated entries.\n",
    "dedupe_cols = [\"id\", \"timestamp\", \"thermidx\", \"win\"]\n",
    "df_main = df_main.drop_duplicates(subset=dedupe_cols, keep=\"first\").reset_index(drop=True)\n"
   ]
